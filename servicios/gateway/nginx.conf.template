server {
    # La imagen oficial de nginx sustituye este archivo con envsubst al arrancar. Solo reemplaza
    # nombres que existan como variable de entorno, así que $uri, $host y similares quedan intactos.
    listen ${PORT};

    # Resolver dinámico: los destinos se resuelven en cada petición y no al arrancar, para que el
    # gateway arranque aunque otro contenedor todavía no exista. NGINX_LOCAL_RESOLVERS lo calcula
    # el entrypoint de la imagen (ver Dockerfile).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

    # Con proxy_pass sobre una variable nginx reenvía la ruta original sin tocarla.
    location /api/libros {
        set $libros "http://${LIBROS_HOST}:8081";
        proxy_pass $libros;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ventas {
        set $ventas "http://${VENTAS_HOST}:8082";
        proxy_pass $ventas;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location / {
        set $frontend "http://${FRONTEND_HOST}:80";
        proxy_pass $frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
